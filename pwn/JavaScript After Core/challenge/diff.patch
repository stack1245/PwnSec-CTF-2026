+JSC_DEFINE_HOST_FUNCTION(functionWin, (JSGlobalObject* globalObject, CallFrame* callFrame))
+{
+    VM& vm = globalObject->vm();
+    auto scope = DECLARE_THROW_SCOPE(vm);
+
+    if (callFrame->argumentCount() < 2)
+        return throwVMTypeError(globalObject, scope, "win expects (string, callback)"_s);
+
+    JSValue stringValue = callFrame->argument(0);
+    JSValue callbackValue = callFrame->argument(1);
+
+    if (!stringValue.isString())
+        return throwVMTypeError(globalObject, scope, "first argument must be a string"_s);
+
+    auto* callback = jsDynamicCast<JSFunction*>(callbackValue);
+    if (!callback)
+        return throwVMTypeError(globalObject, scope, "second argument must be a function"_s);
+
+    JSString* string = asString(stringValue);
+
+    auto currentString = [&]() -> String {
+        return string->value(globalObject);
+    };
+
+    if (currentString() != "hello!!!"_s)
+        return throwVMTypeError(globalObject, scope, "string must start as 'hello!!!'"_s);
+
+    MarkedArgumentBuffer args;
+    args.append(stringValue);
+
+    call(globalObject, callback, jsUndefined(), args, "win"_s);
+    RETURN_IF_EXCEPTION(scope, encodedJSValue());
+    if (currentString() != "pwned!!!"_s)
+        return throwVMTypeError(globalObject, scope, "string did not become 'pwned!!!'"_s);
+
+    call(globalObject, callback, jsUndefined(), args, "win"_s);
+    RETURN_IF_EXCEPTION(scope, encodedJSValue());
+    if (currentString() != "world!!!"_s)
+        return throwVMTypeError(globalObject, scope, "string did not become 'world!!!'"_s);
+
+    FILE* pipe = popen("./readflag", "r");
+    if (!pipe)
+        return throwVMTypeError(globalObject, scope, "failed to run ./readflag"_s);
+
+    char buffer[256];
+    while (fgets(buffer, sizeof(buffer), pipe)) {
+        fputs(buffer, stdout);
+        fflush(stdout);
+    }
+    pclose(pipe);
+
+    return JSValue::encode(jsUndefined());
+}
