<section class="authwrap">
  <div class="panel">
    <p class="eyebrow">404 · signal lost</p>
    <h2 class="panel__title">Nothing at this address</h2>
    <p class="panel__sub">
      The archive has no record of <code><%= HTML.escape(@path) %></code>.
      The lights down here do not respond to it.
    </p>
    <p><a class="btn btn--ghost" href="/">Back to the index</a></p>
  </div>
</section>
